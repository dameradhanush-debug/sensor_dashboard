{
  "version": 1,
  "author": "SensorGrid Water Level Monitoring",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "ultrasonic", "top": -80, "left": 330, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ultrasonic:VCC", "esp:5V", "red", [] ],
    [ "ultrasonic:TRIG", "esp:5", "green", [] ],
    [ "ultrasonic:ECHO", "esp:18", "blue", [] ],
    [ "ultrasonic:GND", "esp:GND.1", "black", [] ]
  ],
  "serialMonitor": {
    "display": "terminal",
    "collapse": false,
    "newline": "lf"
  }
}
