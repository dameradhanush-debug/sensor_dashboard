{
  "version": 1,
  "author": "SensorGrid",
  "editor": "wokwi",

  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },

    {
      "type": "wokwi-hc-sr04",
      "id": "ultrasonic",
      "top": -120,
      "left": 350,
      "attrs": {}
    },

    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 140,
      "left": 260,
      "attrs": {
        "value": "220"
      }
    },

    {
      "type": "wokwi-led",
      "id": "green",
      "top": 140,
      "left": 400,
      "attrs": {
        "color": "green"
      }
    },

    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 200,
      "left": 260,
      "attrs": {
        "value": "220"
      }
    },

    {
      "type": "wokwi-led",
      "id": "yellow",
      "top": 200,
      "left": 400,
      "attrs": {
        "color": "yellow"
      }
    },

    {
      "type": "wokwi-resistor",
      "id": "r3",
      "top": 260,
      "left": 260,
      "attrs": {
        "value": "220"
      }
    },

    {
      "type": "wokwi-led",
      "id": "red",
      "top": 260,
      "left": 400,
      "attrs": {
        "color": "red"
      }
    },

    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 350,
      "left": 400,
      "attrs": {
        "volume": "0.5",
        "mode": "smooth"
      }
    }
  ],

  "connections": [

    ["ultrasonic:VCC", "esp:5V", "red", []],
    ["ultrasonic:GND", "esp:GND.1", "black", []],
    ["ultrasonic:TRIG", "esp:5", "green", []],
    ["ultrasonic:ECHO", "esp:18", "green", []],

    ["esp:25", "r1:1", "green", []],
    ["r1:2", "green:A", "green", []],
    ["green:C", "esp:GND.2", "black", []],

    ["esp:26", "r2:1", "yellow", []],
    ["r2:2", "yellow:A", "yellow", []],
    ["yellow:C", "esp:GND.2", "black", []],

    ["esp:27", "r3:1", "red", []],
    ["r3:2", "red:A", "red", []],
    ["red:C", "esp:GND.2", "black", []],

    ["esp:23", "buzzer:2", "purple", []],
    ["buzzer:1", "esp:GND.2", "black", []]
  ],

  "serialMonitor": {
    "display": "always"
  }
}